<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="mx.com.evoti.hibernate.pojos.PasswordResetTokens" table="password_reset_tokens">
        <id name="prtId" type="java.lang.Integer">
            <column name="prt_id" />
            <generator class="identity" />
        </id>
        <property name="prtUsuId" type="java.lang.Integer">
            <column name="prt_usu_id" not-null="true" />
        </property>
        <property name="prtTokenHash" type="string">
            <column name="prt_token_hash" length="128" not-null="true" />
        </property>
        <property name="prtFechaCreacion" type="timestamp">
            <column name="prt_fecha_creacion" not-null="true" />
        </property>
        <property name="prtFechaExpira" type="timestamp">
            <column name="prt_fecha_expira" not-null="true" />
        </property>
        <property name="prtFechaUso" type="timestamp">
            <column name="prt_fecha_uso" />
        </property>
        <property name="prtEstatus" type="java.lang.Integer">
            <column name="prt_estatus" not-null="true" />
        </property>
        <property name="prtIpSolicitud" type="string">
            <column name="prt_ip_solicitud" length="45" />
        </property>
        <property name="prtUserAgent" type="string">
            <column name="prt_user_agent" length="255" />
        </property>
    </class>
</hibernate-mapping>
